---
/**
 * Tabela de modelos da página "Escreva com o modelo", lida de src/data/modelos.yaml (NAV-14).
 * Um só mecanismo, estático: um h3 por nível (ADR 0013 e ADR 0003). Não tem h2 próprio;
 * entra logo depois do h2 "Escolha o modelo" da página.
 */
import { baseUrl, lerModelos, urlDaPagina, type Nivel } from '../lib/dados';

const GRUPOS: readonly { nivel: Nivel; titulo: string }[] = [
  { nivel: 'nucleo', titulo: 'Comece por estes' },
  { nivel: 'segundo', titulo: 'Mais modelos' },
  { nivel: 'complementar', titulo: 'Trilha complementar' },
];
const modelos = lerModelos();
const grupos = GRUPOS
  .map((grupo) => ({ ...grupo, itens: modelos.filter((modelo) => modelo.nivel === grupo.nivel) }))
  .filter((grupo) => grupo.itens.length > 0);
const base = baseUrl();
---
<div class="template-finder">
  {grupos.map((grupo) => (
    <>
      <h3>{grupo.titulo}</h3>
      <table>
        <thead>
          <tr><th scope="col">O que você precisa fazer</th><th scope="col">Modelo</th><th scope="col">Modelo em texto</th></tr>
        </thead>
        <tbody>
          {grupo.itens.map((modelo) => (
            <tr>
              <td>{modelo.tarefa}</td>
              <td><a href={urlDaPagina(`templates/${modelo.pagina}`)}>{modelo.nome}</a></td>
              <td><a href={`${base}downloads/template-${modelo.slug}.md`} download>Baixar<span class="sr-only">: {modelo.rotulo_download}</span></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))}
</div>
