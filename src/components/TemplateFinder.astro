---
const choices = [
  { id: 'conceito', label: 'Explicar o significado de um termo', href: 'templates/conceito/', summary: 'Glossário e conceitos: definição, sinônimos, variações e exemplos.' },
  { id: 'processo', label: 'Ensinar como executar um trabalho', href: 'templates/processo/', summary: 'Processo: gatilho, atores, etapas, decisões, exceções e saída.' },
  { id: 'decisao', label: 'Formalizar critérios para decidir', href: 'templates/decisao/', summary: 'Regra: condições, precedência, casos-limite e autoridade.' },
  { id: 'politica', label: 'Registrar o que é permitido ou obrigatório', href: 'templates/politica/', summary: 'Política: escopo, vigência, fontes autorizadas, exceções e mudanças.' },
  { id: 'kpi', label: 'Definir como um indicador é calculado', href: 'templates/kpi/', summary: 'KPI: fórmula, universo, datas, filtros e fonte oficial.' },
  { id: 'rubrica', label: 'Definir critérios para avaliar um trabalho', href: 'templates/rubrica/', summary: 'Rubrica: critérios, evidências, níveis, pesos e revisão humana.' },
  { id: 'analytics', label: 'Explicar tabelas, painéis e análises de dados', href: 'dados/visao-geral/', summary: 'Trilha de Dados e Analytics: significado dos dados, junções, dashboards e perguntas de referência.' },
];
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
---
<div class="template-finder" data-template-finder>
  <p class="finder-eyebrow">ASSISTENTE DE ESCOLHA · SEM IA E SEM COLETA DE DADOS</p>
  <h2>O que você precisa documentar?</h2>
  <p>Escolha a finalidade principal. Se um documento mistura assuntos, comece pelo modelo predominante e vincule os demais.</p>
  <fieldset>
    <legend>Tipo de conhecimento</legend>
    {choices.map((choice, i) => (
      <label>
        <input type="radio" name="template-intent" value={choice.id} checked={i === 0}/>
        <span>{choice.label}</span>
      </label>
    ))}
  </fieldset>
  <div class="finder-output">
    <p data-summary role="status" aria-live="polite">{choices[0].summary}</p>
    <a data-link href={base + choices[0].href}>Abrir a página indicada <span aria-hidden="true">→</span></a>
  </div>
</div>
<script define:vars={{ choices, base }}>
  document.querySelectorAll('[data-template-finder]').forEach((root) => {
    const choicesById = Object.fromEntries(choices.map(item => [item.id, item]));
    const summary = root.querySelector('[data-summary]');
    const link = root.querySelector('[data-link]');
    root.querySelectorAll('input[type="radio"]').forEach((input) => {
      input.addEventListener('change', () => {
        const item = choicesById[input.value];
        if (!item) return;
        summary.textContent = item.summary;
        link.setAttribute('href', base + item.href);
      });
    });
  });
</script>
