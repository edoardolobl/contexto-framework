---
/**
 * Substitui o Hero do Starlight (astro.config.mjs, components.Hero).
 * Na home, o título e o texto vêm do frontmatter 'hero' de index.mdx e viram o h1 real da página.
 * Em qualquer outra página com hero (a 404 do Starlight, por exemplo), o Hero padrão continua.
 */
import Default from '@astrojs/starlight/components/Hero.astro';

const route = Astro.locals.starlightRoute;
const isHome = route.id === '' || route.id === 'index';
const { title = route.entry.data.title, tagline } = route.entry.data.hero ?? {};
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
// O link "Pular para o conteúdo" do Starlight aponta para #_top, o id do título da página.
const PAGE_TITLE_ID = '_top';
---
{isHome ? (
  <section class="context-hero">
    <div class="context-hero__copy">
      <span class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> CONTEXTO · DOCUMENTAÇÃO DO CONHECIMENTO</span>
      <h1 id={PAGE_TITLE_ID} class="hero-title" data-page-title set:html={title} />
      {tagline && <p set:html={tagline} />}
      <div class="hero-actions">
        <a class="cta-primary" href={`${base}fundamentos/comece-em-5-minutos/`}>
          Comece em 5 minutos <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="hero-footnote">Um guia prático, aberto e independente de plataformas.</p>
    </div>
  </section>
) : (
  <Default />
)}
