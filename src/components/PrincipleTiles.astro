---
const items = [
  {
    index: '01', category: 'PRIMEIRO DOCUMENTO',
    title: 'Comece em 5 minutos',
    body: 'Você conhece o assunto, mas ainda não sabe como registrar regras, exceções e dúvidas.',
    action: 'Abrir o exercício',
    href: 'fundamentos/comece-em-5-minutos/',
  },
  {
    index: '02', category: 'DOCUMENTO EXISTENTE',
    title: 'Revisar o que já está escrito',
    body: 'Você já tem um manual, procedimento ou definição e quer encontrar lacunas e ambiguidades.',
    action: 'Abrir o roteiro de revisão',
    href: 'validacao/checklist/',
  },
  {
    index: '03', category: 'MODELO PARA REUTILIZAR',
    title: 'Encontrar um modelo por assunto',
    body: 'Você quer escolher um modelo, ver como preenchê-lo e baixar uma versão em texto.',
    action: 'Escolher e baixar um modelo',
    href: 'templates/',
  },
];
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<nav class="principle-tiles task-paths" aria-label="Escolha o que você quer fazer">
  {items.map((item) => <a class="principle-tile" href={`${base}${item.href}`}>
    <span class="tile-index">{item.index} · {item.category}</span>
    <h3>{item.title}</h3>
    <p>{item.body}</p>
    <span class="task-paths__action">{item.action} <span aria-hidden="true">→</span></span>
  </a>)}
</nav>
