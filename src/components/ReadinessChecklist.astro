---
/**
 * Checklist de revisão: um item por dimensão de src/data/dimensoes.yaml (nome e revisao).
 * As oito dimensões são uma convenção do Contexto (ADR 0014).
 */
import { baseUrl, lerDimensoes } from '../lib/dados';

interface Props { title?: string }
const { title = 'Checklist de revisão' } = Astro.props;
const criteria = lerDimensoes().map((d) => [d.nome, d.revisao] as const);
const base = baseUrl();
// Ids estáveis entre builds, derivados do título; cada instância da página tem título próprio.
const uid = 'readiness-' + title.normalize('NFD').replace(/[^\w]+/g, '-').replace(/^-|-$/g, '').toLowerCase();
---
<section class="readiness ctx-card" data-readiness data-total={criteria.length}>
  <p class="eyebrow">VERIFICAÇÃO</p>
  <h3 class="readiness__title">{title}</h3>
  <p>Marque o item quando o documento trouxer uma resposta explícita, não apenas um campo ou um título. <strong>Não é uma nota:</strong> a consistência das respostas e a aprovação da área são verificadas nas próximas etapas.</p>
  <p>As oito dimensões são uma convenção do Contexto. Veja de onde vêm em <a href={`${base}metodo/oito-dimensoes/`}>Checklist das oito dimensões</a>.</p>
  <fieldset>
    <legend class="sr-only">Dimensões da qualidade documental</legend>
    {criteria.map(([label, description], index) => (
      <label class="check-row"><input type="checkbox" value={index} /><span class="check-row__body"><strong>{label}</strong><span>{description}</span></span></label>
    ))}
  </fieldset>
  <p class="readiness-feedback" id={`${uid}-retorno`} data-feedback aria-live="polite">Marque o que o documento já responde. O que ficar sem marca vira a sua lista de lacunas.</p>
  <div class="readiness-gaps" data-gaps hidden>
    <p class="readiness-gaps__title" id={`${uid}-lacunas`}>Lacunas para levar à revisão</p>
    <ul data-gap-list aria-labelledby={`${uid}-lacunas`} aria-describedby={`${uid}-retorno`}></ul>
    <button type="button" class="ctx-button ctx-button--secondary" data-copy>Copiar lista de lacunas</button>
  </div>
  <p class="readiness-copy-status" role="status" data-copy-status></p>
  <div class="readiness-footer"><button type="button" class="ctx-button ctx-button--secondary" data-reset>Limpar seleção</button><span>Os dados não são enviados ou armazenados.</span></div>
</section>
<script>
  const INITIAL = 'Marque o que o documento já responde. O que ficar sem marca vira a sua lista de lacunas.';
  const NONE_OPEN = 'Nenhuma lacuna no checklist de revisão. Agora confronte as afirmações com as fontes e peça a confirmação de quem responde pelo conteúdo.';
  const openMessage = (open: number, total: number) =>
    (open === 1 ? `Falta 1 de ${total} dimensões.` : `Faltam ${open} de ${total} dimensões.`) +
    ' Sem marca, a dimensão vira lacuna. Leve a lista abaixo para quem responde pelo conteúdo.';

  document.querySelectorAll<HTMLElement>('[data-readiness]').forEach((root) => {
    const checks = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const total = Number(root.dataset.total) || checks.length;
    const feedback = root.querySelector<HTMLElement>('[data-feedback]');
    const gaps = root.querySelector<HTMLElement>('[data-gaps]');
    const gapList = root.querySelector<HTMLElement>('[data-gap-list]');
    const copy = root.querySelector<HTMLButtonElement>('[data-copy]');
    const copyStatus = root.querySelector<HTMLElement>('[data-copy-status]');
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]');
    const label = (c: HTMLInputElement) => {
      const body = c.closest('label');
      const name = body?.querySelector('strong')?.textContent ?? '';
      const question = body?.querySelector('.check-row__body > span')?.textContent ?? '';
      return { name, question };
    };
    // O resultado da cópia fica até a próxima ação; não há timer que apague a mensagem.
    const clearCopyStatus = () => { if (copyStatus) copyStatus.textContent = ''; };
    let touched = false;
    function update() {
      const open = checks.filter(c => !c.checked);
      if (feedback) feedback.textContent = !touched
        ? INITIAL
        : open.length === 0 ? NONE_OPEN : openMessage(open.length, total);
      if (gaps && gapList) {
        gaps.hidden = !touched || open.length === 0;
        gapList.replaceChildren(...open.map((c) => {
          const { name, question } = label(c);
          const li = document.createElement('li');
          const strong = document.createElement('strong');
          strong.textContent = name;
          li.append(strong, ': ' + question);
          return li;
        }));
      }
    }
    checks.forEach(c => c.addEventListener('change', () => { touched = true; clearCopyStatus(); update(); }));
    reset?.addEventListener('click', () => {
      checks.forEach(c => { c.checked = false; });
      touched = false;
      clearCopyStatus();
      update();
    });
    copy?.addEventListener('click', async () => {
      clearCopyStatus();
      const lines = checks.filter(c => !c.checked).map((c) => {
        const { name, question } = label(c);
        return '- ' + name + ': ' + question;
      });
      const textToCopy = 'Lacunas encontradas no checklist de revisão (oito dimensões):\n' + lines.join('\n');
      let message: string;
      try {
        await navigator.clipboard.writeText(textToCopy);
        message = 'Lista copiada';
      } catch {
        message = 'Não foi possível copiar; selecione a lista e copie';
      }
      if (copyStatus) copyStatus.textContent = message;
    });
    update();
  });
</script>
