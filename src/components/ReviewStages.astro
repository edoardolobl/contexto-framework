---
/**
 * Roteiro editorial estático: três verificações independentes.
 * Não calcula uma nota, não armazena dados e não atribui aprovação.
 * Os nomes das etapas não são títulos: o componente vem logo depois do h1 da página,
 * e cada etapa já tem a sua seção (h2) logo abaixo.
 */
const stages = [
  {
    number: '01',
    title: 'Cobertura',
    question: 'O documento explica o necessário?',
    description: 'Use o checklist de revisão (oito dimensões, convenção do Contexto) e anote o que falta. Um campo preenchido não significa que seja verdadeiro.',
    outcome: 'Saída: lacunas identificadas',
  },
  {
    number: '02',
    title: 'Consistência e evidências',
    question: 'As afirmações podem ser verificadas?',
    description: 'Para cada regra decisiva, confira a fonte, a vigência, os exemplos e possíveis contradições.',
    outcome: 'Saída: afirmações verificadas ou contestadas',
  },
  {
    number: '03',
    title: 'Confirmação por responsável',
    question: 'Quem tem autoridade concorda?',
    description: 'Solicite revisão da versão específica, registre o parecer e não marque como aprovada uma dúvida ainda aberta.',
    outcome: 'Saída: aprovação ou pergunta em aberto registrada',
  },
];
---
<ol class="review-stages" aria-label="Três etapas independentes de revisão documental">
  {stages.map((stage) => <li class="review-stages__card">
    <span class="review-stages__number" aria-hidden="true">{stage.number}</span>
    <p class="review-stages__title"><strong>{stage.title}</strong></p>
    <p class="review-stages__question">{stage.question}</p>
    <p>{stage.description}</p>
    <p class="review-stages__outcome">{stage.outcome}</p>
  </li>)}
</ol>
