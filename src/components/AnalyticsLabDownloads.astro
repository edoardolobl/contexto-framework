---
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
interface Props { lab?: '1' | '2' }
const { lab = '1' } = Astro.props;
const arquivos = {
  '1': [
    {name: 'Dados do laboratório',file:'aurora-fixture.sql',note:'SQLite · DDL e 12 registros'},
    {name: 'Consulta SQL de referência',file:'aurora-reference-query.sql',note:'SQLite · cálculo de 25% para a amostra'},
    {name: 'Dicionário da tabela de pedidos',file:'exemplo-dataset-pedidos-completo.yaml',note:'YAML · aprovado'}
  ],
  '2': [
    {name: 'Dados do laboratório de eventos',file:'aurora-lab2-fixture.sql',note:'SQLite · plano, eventos diários, carga, pedidos e itens'},
    {name: 'Consulta SQL de referência',file:'aurora-lab2-reference-query.sql',note:'SQLite · eventos parados por operação'},
    {name: 'Gabarito das perguntas',file:'exemplo-perguntas-de-negocio-eventos-completo.yaml',note:'YAML · aprovado'}
  ]
};
const files = arquivos[lab] ?? arquivos['1'];
---
<div class="template-downloads" role="group" aria-label={lab === '2' ? 'Arquivos do laboratório Aurora de eventos' : 'Arquivos do laboratório Aurora'}>
  {files.map(item => <a href={base + 'downloads/' + item.file} download>
    <span class="download-icon" aria-hidden="true">↓</span>
    <span class="download-name">{item.name}<small>{item.note}</small></span>
  </a>)}
</div>
