---
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'yaml';

interface Props { kind: 'conceito' | 'kpi' }
const { kind } = Astro.props;
const files = kind === 'conceito'
  ? ['historico/exemplo-conceito-v1.0.yaml', 'exemplo-conceito-completo.yaml']
  : ['historico/exemplo-kpi-v1.0.yaml', 'exemplo-kpi-completo.yaml'];
const entries = files.map(file => {
  const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'downloads', file), 'utf8');
  return { ...parse(raw), file };
});
const prettyDate = (date: string | null) => date?.split('-').reverse().join('/') ?? 'Sem fim registrado';
// valid_to no YAML é exclusivo; ao leitor, mostramos o último dia incluído.
const lastDay = (endExclusive: string | null) => {
  if (!endExclusive) return 'Sem fim registrado';
  const end = new Date(endExclusive + 'T00:00:00Z');
  end.setUTCDate(end.getUTCDate() - 1);
  return prettyDate(end.toISOString().slice(0, 10));
};
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const rule = (doc: any) => kind === 'conceito' ? doc.definition : doc.calculation?.formula_description;
const details = (doc: any) => kind === 'conceito'
  ? doc.inclusion_criteria?.[1] ?? doc.inclusion_criteria?.[0]
  : doc.calculation?.numerator;
---
<section class="revision-comparison" aria-label="Duas versões do mesmo documento fictício">
  {entries.map((doc, i) => <article class:list={['revision-comparison__card', i === 1 && 'revision-comparison__card--current']}>
    <p class="panel-kicker">{i === 0 ? 'VERSÃO HISTÓRICA · NÃO VIGENTE' : 'VERSÃO ATUAL NO EXEMPLO FICTÍCIO'}</p>
    <h3>Versão {doc.version}</h3>
    <dl class="revision-comparison__metadata">
      <div class="revision-comparison__metadata-id"><dt>ID do assunto</dt><dd><code>{doc.id}</code></dd></div>
      <div class="revision-comparison__metadata-id"><dt>ID da versão</dt><dd><code>{doc.revision_id}</code></dd></div>
      <div><dt>Data do registro</dt><dd>{prettyDate(doc.version_date)}</dd></div>
      <div><dt>Regra válida desde</dt><dd>{prettyDate(doc.valid_from)}</dd></div>
      <div><dt>Último dia de vigência</dt><dd>{lastDay(doc.valid_to)}</dd></div>
    </dl>
    <div class="revision-comparison__rule">
      <strong>{kind === 'conceito' ? 'Definição nesta versão' : 'Fórmula nesta versão'}</strong>
      <p>{rule(doc)}</p>
      {details(doc) && <small>{details(doc)}</small>}
    </div>
    <a class="revision-comparison__download" href={base + 'downloads/' + doc.file} download>
      Baixar versão {doc.version} <span aria-hidden="true">↓</span>
    </a>
  </article>)}
</section>
<p class="revision-comparison__notice">Exemplos inteiramente fictícios. A aprovação representa somente a narrativa da Aurora. As duas versões nunca têm vigência simultânea.</p>
