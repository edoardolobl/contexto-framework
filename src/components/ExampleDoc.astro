---
/**
 * Exemplo extraído do mesmo YAML entregue no download.
 * Três formas de ver o mesmo documento, em abas: o que ele diz, a identificação
 * com o histórico e o arquivo YAML. A linha de versão fica fora das abas,
 * sempre visível, porque é a lição principal sobre versões.
 *
 * nivel: nível do título do exemplo (padrão 3, para uso logo depois de um h2).
 * Os títulos internos ficam sempre um nível abaixo.
 */
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'yaml';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import ExampleMeaning from './ExampleMeaning.astro';

type Nivel = 2 | 3 | 4 | 5;
interface Props { file: string; nivel?: Nivel }
const { file, nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3' | 'h4' | 'h5';
const subnivel = Math.min(nivel + 1, 6) as 3 | 4 | 5 | 6;
const Subtitulo = `h${subnivel}` as 'h3' | 'h4' | 'h5' | 'h6';
const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'downloads', file), 'utf8');
const doc = parse(raw);
const STATUS: Record<string, string> = {
  draft: 'Rascunho',
  pending_approval: 'Pendente de aprovação',
  approved: 'Aprovado',
  deprecated: 'Obsoleto',
};
const complete = doc.status === 'approved';
const hasOwner = typeof doc.owner === 'string' && doc.owner.trim().length > 0;
const hasSource = typeof doc.source_of_truth === 'string' && doc.source_of_truth.trim().length > 0;
const draftByline = !hasOwner && !hasSource
  ? 'Responsável e fonte ainda não definidos'
  : [hasOwner ? 'Responsável: ' + doc.owner : 'Responsável ainda não definido',
     hasSource ? 'Fonte: ' + doc.source_of_truth : 'Fonte ainda não definida'].join(' · ');
const text = (v: unknown) => (v === null || v === undefined || v === '' ? 'Ainda não definido' : String(v));
const isDay = (v: unknown): v is string => typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v);
const date = (v: unknown) => (isDay(v) ? v.split('-').reverse().join('/') : text(v));
/** valid_to é exclusivo; para quem lê, mostramos o último dia em que a versão vale. */
const dayBefore = (v: string) => {
  const d = new Date(v + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() - 1);
  return d.toISOString().slice(0, 10);
};
const lastDay = isDay(doc.valid_to)
  ? date(dayBefore(doc.valid_to))
  : (complete ? 'Sem fim registrado' : 'Ainda não definido');

const history: any[] = doc.version_history ?? [];
const current = history[0];
const previous = doc.supersedes_revision ? history[1] : undefined;
const questions = (doc.open_questions ?? []).map((q: any) => (typeof q === 'string' ? { text: q } : { text: q.question, impact: q.impact }));
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<section class:list={['example-doc', complete ? 'example-doc--complete' : 'example-doc--gaps']}>
  <p class="panel-kicker">{complete ? 'EXEMPLO COMPLETO' : 'EXEMPLO COM LACUNAS · NADA APROVADO'}</p>
  <Titulo class="example-doc__title">{doc.title}</Titulo>
  <p class="example-doc__byline">
    {complete
      ? <>Aprovado por {text(doc.approver)}<span aria-hidden="true"> · </span>Fonte: {text(doc.source_of_truth)}</>
      : draftByline}
  </p>

  <div class="example-doc__revision" role="group" aria-label="Versão deste documento">
    {previous && isDay(doc.valid_from) && <>
      <span class="example-doc__revision-old">
        Versão {previous.version} · até {date(dayBefore(doc.valid_from))}
      </span>
      <span class="example-doc__revision-arrow" aria-hidden="true">→</span>
    </>}
    {complete
      ? <span class="example-doc__revision-current">Versão {doc.version} · vigente desde {date(doc.valid_from)}</span>
      : <span class="example-doc__revision-draft">{STATUS[doc.status] ?? doc.status} {doc.version} · nada aprovado ainda</span>}
  </div>
  {complete && current && <p class="example-doc__change">
    <strong>{previous ? 'O que mudou:' : 'Nesta versão:'}</strong> {text(current.change)}
  </p>}

  <div class="example-doc__tabs">
    <Tabs>
      <TabItem label="O que diz">
        <ExampleMeaning doc={doc} nivel={subnivel}/>
        {questions.length > 0 && <section class="example-doc__gaps" aria-label="Perguntas que ainda precisam de resposta">
          <Subtitulo class="example-doc__gaps-title">Perguntas em aberto ({questions.length})</Subtitulo>
          <ul>{questions.map((q: any) => <li>{q.text}{q.impact && <span class="example-doc__impact">Se ficar sem resposta: {q.impact}</span>}</li>)}</ul>
        </section>}
      </TabItem>
      <TabItem label="Identificação e histórico">
        <dl class="example-doc__ids">
          <div><dt>ID do assunto</dt><dd><code>{doc.id}</code></dd></div>
          <div><dt>ID da versão</dt><dd><code>{text(doc.revision_id)}</code></dd></div>
          <div><dt>Estado</dt><dd>{STATUS[doc.status] ?? doc.status}</dd></div>
          <div><dt>Responsável</dt><dd>{text(doc.owner)}</dd></div>
          <div><dt>Quem aprova</dt><dd>{text(doc.approver)}</dd></div>
          <div><dt>Versão e data</dt><dd>{doc.version} · {date(doc.version_date)}</dd></div>
          <div><dt>Vale a partir de</dt><dd>{date(doc.valid_from)}</dd></div>
          <div><dt>Último dia de vigência</dt><dd>{lastDay}</dd></div>
          <div><dt>Substitui a versão</dt><dd>{doc.supersedes_revision ? <code>{doc.supersedes_revision}</code> : 'Nenhuma'}</dd></div>
        </dl>
        <div class="example-doc__history-scroll" role="region" aria-label="Histórico de mudanças do documento" tabindex="0">
          <table>
            <caption>Histórico de mudanças (o resumo não guarda a versão antiga completa)</caption>
            <thead><tr><th scope="col">Versão</th><th scope="col">Data</th><th scope="col">O que mudou</th><th scope="col">Aprovado por</th></tr></thead>
            <tbody>{history.map((v: any) => (
              <tr><td>{v.version}</td><td>{date(v.date)}</td><td>{text(v.change)}</td><td>{v.approved_by ?? 'Não aprovado'}</td></tr>
            ))}</tbody>
          </table>
        </div>
      </TabItem>
      <TabItem label="YAML">
        <p class="example-doc__yaml-note">O mesmo documento no formato que um sistema de IA ou uma pessoa técnica consegue processar. O conteúdo é idêntico ao das outras abas.</p>
        <Code code={raw} lang="yaml" title={file} />
      </TabItem>
    </Tabs>
  </div>

  <div class="example-doc__footer">
    <a class="example-doc__download" href={base + 'downloads/' + file} download>Baixar YAML <span aria-hidden="true">↓</span></a>
  </div>
</section>
