---
/** Exemplo didático extraído do mesmo YAML entregue no download. */
import fs from 'node:fs';
import path from 'node:path';
import { parse } from 'yaml';
import { Code } from '@astrojs/starlight/components';
import ExampleMeaning from './ExampleMeaning.astro';

interface Props { file: string }
const { file } = Astro.props;
const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'downloads', file), 'utf8');
const doc = parse(raw);
const STATUS: Record<string, string> = {
  draft: 'Rascunho',
  pending_approval: 'Pendente de aprovação',
  approved: 'Aprovado (aprovação fictícia)',
  deprecated: 'Obsoleto',
};
const complete = doc.status === 'approved';
const text = (v: unknown) => (v === null || v === undefined || v === '' ? 'Ainda não definido' : String(v));
const date = (v: unknown) => (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v.split('-').reverse().join('/') : text(v));
const questions = (doc.open_questions ?? []).map((q: any) => (typeof q === 'string' ? q : q.question));
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<section class:list={['example-doc', complete ? 'example-doc--complete' : 'example-doc--gaps']}>
  <p class="panel-kicker">{complete ? 'EXEMPLO COMPLETO · APROVAÇÃO FICTÍCIA' : 'EXEMPLO COM LACUNAS · NADA APROVADO'}</p>
  <p class="example-doc__title">{doc.title}</p>
  <p class="example-doc__status-line">
    <strong>{STATUS[doc.status] ?? doc.status}</strong>
    <span aria-hidden="true">·</span>
    Revisão <code>{doc.version}</code>
    <span aria-hidden="true">·</span>
    {complete ? 'Vigente no exemplo desde ' + date(doc.valid_from) : 'Vigência não aprovada'}
  </p>

  <ExampleMeaning doc={doc}/>

  {questions.length > 0 && <section class="example-doc__gaps" aria-label="Perguntas que ainda precisam de resposta">
    <h4>Perguntas em aberto ({questions.length})</h4>
    <ul>{questions.map((q: string) => <li>{q}</li>)}</ul>
  </section>}

  <p class="example-doc__source"><strong>Fonte {complete ? 'fictícia de referência' : 'a confirmar'}:</strong> {text(doc.source_of_truth)}</p>

  {complete && <p class="panel-note">A Aurora não existe. Responsável, datas, fonte e aprovação são inventados para mostrar o documento pronto.</p>}

  <details class="example-doc__details">
    <summary>
      <svg class="example-doc__disclosure-chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m9 5 7 7-7 7" />
      </svg>
      <span class="example-doc__disclosure-copy">
        <span class="example-doc__disclosure-title">Dados técnicos e YAML</span>
        <span class="example-doc__disclosure-subtitle">Identificação, responsáveis, vigência, histórico e arquivo fonte completo.</span>
      </span>
      <span class="example-doc__disclosure-tag" aria-hidden="true">Opcional</span>
    </summary>
    <div class="example-doc__details-content">
      <h4>Identificação, responsáveis e vigência</h4>
    <dl>
      <div><dt>ID do assunto</dt><dd><code>{doc.id}</code></dd></div>
      <div><dt>ID da revisão</dt><dd><code>{text(doc.revision_id)}</code></dd></div>
      <div><dt>Estado</dt><dd>{STATUS[doc.status] ?? doc.status}</dd></div>
      <div><dt>Responsável</dt><dd>{text(doc.owner)}</dd></div>
      <div><dt>Quem aprova</dt><dd>{text(doc.approver)}</dd></div>
      <div><dt>Versão e data</dt><dd>{doc.version} · {date(doc.version_date)}</dd></div>
      <div><dt>Regra válida desde</dt><dd>{date(doc.valid_from)}</dd></div>
      <div><dt>Regra válida até</dt><dd>{doc.valid_to ? `Antes de ${date(doc.valid_to)}` : (complete ? 'Sem fim documentado' : 'Ainda não definido')}</dd></div>
      <div><dt>Substitui revisão</dt><dd>{doc.supersedes_revision ? <code>{doc.supersedes_revision}</code> : 'Nenhuma registrada'}</dd></div>
    </dl>
    <div class="example-doc__history-scroll" role="region" aria-label="Histórico de mudanças do documento" tabindex="0">
      <table>
        <caption>Histórico de mudanças (o resumo não contém a versão antiga completa)</caption>
      <thead><tr><th scope="col">Versão</th><th scope="col">Data</th><th scope="col">O que mudou</th><th scope="col">Aprovado por</th></tr></thead>
      <tbody>{(doc.version_history ?? []).map((v: any) => (
        <tr><td>{v.version}</td><td>{date(v.date)}</td><td>{text(v.change)}</td><td>{v.approved_by ?? 'Não aprovado'}</td></tr>
      ))}</tbody>
      </table>
    </div>
      <h4>Arquivo YAML integral</h4>
      <Code code={raw} lang="yaml" title={file} />
    </div>
  </details>
  <p class="example-doc__download"><a href={base + 'downloads/' + file} download>Baixar este exemplo <span aria-hidden="true">↓</span></a></p>
</section>
