---
/**
 * Desenho da relação 1:N do Laboratório Aurora: sessões elegíveis de 01/10/2026 ligadas aos pedidos.
 * Os valores vêm da amostra aurora-fixture.sql; check_analytics_fixture.py confere as contas.
 */
interface Props { showCounts?: boolean }
const { showCounts = false } = Astro.props;
const sessions = [
  { id: 'S1', y: 44, hit: true },
  { id: 'S2', y: 104, hit: false },
  { id: 'S5', y: 164, hit: false },
  { id: 'S6', y: 224, hit: false },
];
const orders = [
  { id: 'O1', status: 'CONFIRMED', y: 34, from: 'S1', hit: true },
  { id: 'O2', status: 'CONFIRMED', y: 82, from: 'S1', hit: true },
  { id: 'O3', status: 'CANCELED', y: 134, from: 'S2', hit: false },
  { id: 'O6', status: 'TEST', y: 194, from: 'S5', hit: false },
];
const sy = Object.fromEntries(sessions.map((s) => [s.id, s.y + 20]));
---
<figure class="rel-diagram">
  <svg viewBox="0 0 600 280" role="img" aria-labelledby="jd-title jd-desc">
    <title id="jd-title">Sessões web elegíveis ligadas aos pedidos</title>
    <desc id="jd-desc">A sessão S1 tem dois pedidos confirmados, O1 e O2. S2 tem um pedido cancelado, S5 um pedido de teste e S6 nenhum pedido.</desc>
    <text class="jd-head" x="40" y="22">demo_sessions · uma linha por sessão</text>
    <text class="jd-head" x="370" y="22">demo_orders · uma linha por pedido</text>
    {orders.map((o) => <line class={o.hit ? 'jd-link jd-link--hit' : 'jd-link'} x1="210" y1={sy[o.from]} x2="370" y2={o.y + 18} />)}
    {sessions.map((s) => <g>
      <rect class={s.hit ? 'jd-box jd-box--hit' : 'jd-box'} x="40" y={s.y} width="170" height="40" rx="6" />
      <text class="jd-id" x="56" y={s.y + 25}>{s.id}</text>
      <text class="jd-note" x="92" y={s.y + 25}>web, não interna</text>
    </g>)}
    <text class="jd-note" x="222" y={sy.S6 + 4}>sem pedido</text>
    {orders.map((o) => <g>
      <rect class={o.hit ? 'jd-box jd-box--hit' : 'jd-box'} x="370" y={o.y} width="190" height="36" rx="6" />
      <text class="jd-id" x="386" y={o.y + 23}>{o.id}</text>
      <text class="jd-note" x="422" y={o.y + 23}>{o.status}</text>
    </g>)}
  </svg>
  <figcaption>As quatro sessões que entram na conta em 01/10/2026. S3 (interna) e S4 (app) ficam fora antes da junção, com os pedidos O4 e O5.</figcaption>
  {showCounts && <div class="jd-counts">
    <div class="jd-count jd-count--wrong">
      <p class="jd-kicker">CONTAR LINHAS DEPOIS DA JUNÇÃO</p>
      <p class="jd-number">2 ÷ 4 = 50%</p>
      <p>S1 vira duas linhas, uma por pedido. O resultado mede pedidos confirmados por sessão, que é outra pergunta.</p>
    </div>
    <div class="jd-count jd-count--right">
      <p class="jd-kicker">CONTAR SESSÕES DISTINTAS</p>
      <p class="jd-number">1 ÷ 4 = 25%</p>
      <p>S1 conta uma vez, tenha um ou dois pedidos. É a taxa de sessões convertidas do indicador.</p>
    </div>
  </div>}
</figure>

<style>
  .rel-diagram { margin: 1.5rem 0; }
  .rel-diagram svg { width: 100%; height: auto; max-width: 600px; display: block; }
  .jd-head { font: 600 12px var(--sl-font); fill: var(--context-muted); }
  .jd-id { font: 700 14px var(--sl-font); fill: var(--context-ink); }
  .jd-note { font: 12px var(--sl-font); fill: var(--context-muted); }
  .jd-box { fill: var(--context-surface); stroke: var(--context-line); stroke-width: 1.5; }
  .jd-box--hit { fill: var(--sl-color-accent-low); stroke: var(--sl-color-accent); stroke-width: 2; }
  .jd-link { stroke: var(--context-line); stroke-width: 1.5; }
  .jd-link--hit { stroke: var(--sl-color-accent); stroke-width: 2.5; }
  .rel-diagram figcaption { font-size: .85rem; color: var(--context-muted); margin-top: .5rem; }
  .jd-counts { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .75rem; margin-top: 1rem; }
  .jd-count { margin: 0 !important; border: 1px solid var(--context-line); border-radius: 8px; padding: .9rem 1rem; background: var(--context-surface); }
  .jd-count--right { border-color: var(--sl-color-accent); }
  .jd-count p { margin: 0; font-size: .87rem; line-height: 1.55; color: var(--context-ink); }
  .jd-kicker { font-size: .72rem !important; letter-spacing: .08em; font-weight: 700; color: var(--context-muted) !important; }
  .jd-number { font-size: 1.35rem !important; font-weight: 750; margin: .35rem 0 !important; }
  .jd-count--wrong .jd-number { color: var(--context-gold); }
  .jd-count--right .jd-number { color: var(--sl-color-accent); }
</style>
