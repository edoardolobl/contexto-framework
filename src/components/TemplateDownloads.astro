    { name: 'Exemplo completo', href: 'exemplo-kpi-completo.yaml', format: 'YAML · aprovado' },
  ],
};
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
---
<div class="template-downloads" role="group" aria-label="Arquivos de exemplo e template para reutilizar">
  {files[kind].map((file) => <a href={base + 'downloads/' + file.href} download>
    <span class="download-icon" aria-hidden="true">↓</span>
    <span class="download-name">{file.name}<small>{file.format}</small></span>
  </a>)}
</div>
