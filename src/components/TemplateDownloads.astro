---
/**
 * Os quatro arquivos de um modelo, montados a partir do slug de src/data/modelos.yaml.
 * kind: o slug do tipo (Perguntas de negócio usa 'casos-teste' até a F3).
 */
import { baseUrl, modeloPorSlug } from '../lib/dados';

interface Props { kind: string }
const { kind } = Astro.props;
const modelo = modeloPorSlug(kind);
const arquivos = [
  { name: modelo.rotulo_download, href: `template-${modelo.slug}.md`, format: 'Markdown · para preencher em texto' },
  { name: 'Modelo estruturado', href: `template-${modelo.slug}.yaml`, format: 'YAML · campos vazios' },
  { name: 'Exemplo com lacunas', href: `exemplo-${modelo.slug}-lacunas.yaml`, format: 'YAML · nada aprovado' },
  { name: 'Exemplo completo', href: `exemplo-${modelo.slug}-completo.yaml`, format: 'YAML · aprovado' },
];
const base = baseUrl();
---
<div class="template-downloads" role="group" aria-label="Arquivos de exemplo e modelo para reutilizar">
  {arquivos.map((arquivo) => <a href={`${base}downloads/${arquivo.href}`} download>
    <span class="download-icon" aria-hidden="true">↓</span>
    <span class="download-name">{arquivo.name}<small>{arquivo.format}</small></span>
  </a>)}
</div>
