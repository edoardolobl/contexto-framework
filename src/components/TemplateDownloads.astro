    { name: 'Exemplo completo', href: 'exemplo-processo-completo.yaml', format: 'YAML · aprovado' },
  ],
  decisao: [
    { name: 'Modelo de decisão', href: 'template-decisao.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-decisao.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-decisao-ficticia.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-decisao-completo.yaml', format: 'YAML · aprovado' },
  ],
  politica: [
    { name: 'Modelo de política', href: 'template-politica.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-politica.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-politica-ficticia.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-politica-completo.yaml', format: 'YAML · aprovado' },
  ],
  dataset: [
    { name: 'Modelo de dataset', href: 'template-dataset.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-dataset.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-dataset-ficticio.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-dataset-completo.yaml', format: 'YAML · aprovado' },
  ],
  relacionamento: [
    { name: 'Modelo de relacionamento', href: 'template-relacionamento.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-relacionamento.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-relacionamento-ficticio.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-relacionamento-completo.yaml', format: 'YAML · aprovado' },
  ],
  dashboard: [
    { name: 'Modelo de dashboard', href: 'template-dashboard.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-dashboard.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-dashboard-ficticio.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-dashboard-completo.yaml', format: 'YAML · aprovado' },
  ],
  rubrica: [
    { name: 'Modelo de rubrica', href: 'template-rubrica.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-rubrica.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-rubrica-ficticia.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-rubrica-completo.yaml', format: 'YAML · aprovado' },
  ],
  'casos-teste': [
    { name: 'Modelo de gabarito', href: 'template-casos-teste.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-casos-teste.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-casos-teste-ficticios.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-casos-teste-completo.yaml', format: 'YAML · aprovado' },
  ],
  kpi: [
    { name: 'Modelo de KPI', href: 'template-kpi.md', format: 'Markdown · para preencher em texto' },
