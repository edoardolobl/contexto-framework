---
interface Props {
  kind: 'conceito' | 'processo' | 'decisao' | 'politica' | 'kpi' | 'dataset' | 'relacionamento' | 'dashboard' | 'rubrica' | 'casos-teste';
}
const { kind } = Astro.props;
const files: Record<Props['kind'], { name: string; href: string; format: string }[]> = {
  conceito: [
    { name: 'Modelo de conceito', href: 'template-conceito.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-conceito.yaml', format: 'YAML · campos vazios' },
    { name: 'Exemplo com lacunas', href: 'exemplo-conceito-ficticio.yaml', format: 'YAML · nada aprovado' },
    { name: 'Exemplo completo', href: 'exemplo-conceito-completo.yaml', format: 'YAML · aprovado' },
  ],
  processo: [
    { name: 'Modelo de processo', href: 'template-processo.md', format: 'Markdown · para preencher em texto' },
    { name: 'Modelo estruturado', href: 'template-processo.yaml', format: 'YAML · campos vazios' },
