---
/**
 * Os quatro arquivos de um modelo, montados a partir do slug de src/data/modelos.yaml.
 * kind: o slug do tipo, igual ao type do documento e ao nome dos arquivos.
 * O modelo em texto (.md) é o botão principal; os outros três são secundários (UX-06).
 */
import { LinkButton } from '@astrojs/starlight/components';
import { baseUrl, modeloPorSlug } from '../lib/dados';

interface Props { kind: string }
const { kind } = Astro.props;
const modelo = modeloPorSlug(kind);
const arquivos = [
  { name: modelo.rotulo_download, href: `template-${modelo.slug}.md`, format: 'Markdown · campos no topo e explicação em português' },
  { name: 'Modelo estruturado', href: `template-${modelo.slug}.yaml`, format: 'YAML · gerado do Markdown' },
  { name: 'Exemplo com lacunas', href: `exemplo-${modelo.slug}-lacunas.yaml`, format: 'YAML · nada aprovado' },
  { name: 'Exemplo completo', href: `exemplo-${modelo.slug}-completo.yaml`, format: 'YAML · aprovado' },
];
const base = baseUrl();
---
<div class="template-downloads" role="group" aria-label="Arquivos de exemplo e modelo para reutilizar">
  {arquivos.map((arquivo, indice) => (
    <div class="template-downloads__item">
      <LinkButton href={`${base}downloads/${arquivo.href}`} variant={indice === 0 ? 'primary' : 'secondary'} download>
        {arquivo.name} <span aria-hidden="true">↓</span>
      </LinkButton>
      <p class="template-downloads__formato">{arquivo.format}</p>
    </div>
  ))}
</div>
