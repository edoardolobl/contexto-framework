---
/**
 * Visão pedagógica do documento.
 * Os valores vêm diretamente do YAML já usado nos downloads: não são cópias
 * editoriais nem conteúdo gerado/inferido no momento da visualização.
 */
// nivel: nível dos títulos dos grupos; ExampleDoc passa um abaixo do título do exemplo.
interface Props { doc: Record<string, any>; nivel?: 3 | 4 | 5 | 6 }
const { doc, nivel = 4 } = Astro.props;
const Titulo = `h${nivel}` as 'h3' | 'h4' | 'h5' | 'h6';
type Pair = { label: string; value: string; items?: string[] };
type Entry = { heading: string; body?: string; items?: string[]; note?: string; detail?: string; levels?: Record<string, string> };
type Group = { heading: string; pairs?: Pair[]; bullets?: string[]; entries?: Entry[] };

const present = (v: any): boolean =>
  v !== null && v !== undefined && v !== '' &&
  (!Array.isArray(v) || v.length > 0);

const display = (v: any): string => {
  if (v === true) return 'Sim';
  if (v === false) return 'Não';
  if (Array.isArray(v)) return v.map(display).join(' · ');
  return present(v) ? String(v) : 'Ainda não definido';
};
const pair = (label: string, value: any, showMissing = false): Pair[] =>
  present(value) || showMissing
    ? [{ label, value: display(value), items: Array.isArray(value) && value.length > 1 ? value.map(display) : undefined }]
    : [];
const list = (value: any): string[] =>
  Array.isArray(value) ? value.filter((v) => typeof v === 'string' && v.trim()).map(String) : [];
const groups: Group[] = [];
const add = (heading: string, pairs: Pair[] = [], bullets: string[] = [], entries: Entry[] = []) => {
  if (pairs.length || bullets.length || entries.length) groups.push({ heading, pairs, bullets, entries });
};
const entryList = (value: string[], label = 'Item'): Entry[] => value.map((v, i) => ({
  heading: `${label} ${i + 1}`, body: v,
}));

let decisionTable: { labels: string[]; rows: string[][] } | null = null;
const decisionInputLabel = (key: string) => ({
  brief_complete: 'Brief completo?',
  evidence_sufficient: 'Evidência suficiente?',
  active_in_scope: 'Ativo nesta operação?',
  ingestion_complete: 'Dados completos (D+2)?',
  expected_in_window: 'Disparo esperado na janela?',
  deviation_streak_reached: 'Desvio da linha de base por N dias seguidos?',
  known_exception_applies: 'Exceção conhecida explica?',
} as Record<string, string>)[key] || key.replaceAll('_', ' ');
const decisionValue = (v: any) => ({
  true: 'Sim',
  false: 'Não',
  unknown: 'Desconhecido',
  any: 'Qualquer',
  complement_information: 'Devolver para complementação',
  responsible_review: 'Revisão responsável',
  request_formal_approval: 'Solicitar aprovação formal',
  request_clarification: 'Solicitar esclarecimento',
  not_active_in_scope: 'Não está ativo aqui: zero é o esperado',
  wait_for_complete_data: 'Esperar os dados completos',
  explained_by_known_exception: 'Explicado por exceção conhecida',
  within_expected: 'Dentro do esperado',
  failure_candidate: 'Candidato a falha: abrir a triagem',
} as Record<string, string>)[String(v)] || display(v).replaceAll('_', ' ');

// Datas AAAA-MM-DD aparecem como DD/MM/AAAA para quem lê.
const dia = (v: any) => (typeof v === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v) ? v.split('-').reverse().join('/') : v);

// Pergunta de negócio que o documento responde: abre o primeiro grupo de todo tipo.
const question = () => pair('Pergunta de negócio', doc.intent?.question, true);

switch (doc.type) {
  case 'conceito':
    add('Definição e contexto', [
      ...question(),
      ...pair('Termo', doc.vocabulary?.prefLabel),
      ...pair('Definição', doc.definition, true),
      ...pair('Para que serve', doc.intent?.purpose),
      ...pair('Quando se aplica', doc.scope?.applies_when),
      ...pair('Quando não se aplica', doc.scope?.does_not_apply_when),
    ]);
    add('Critérios para reconhecer o conceito', [
      ...pair('Inclui', doc.inclusion_criteria),
      ...pair('Exclui', doc.exclusion_criteria),
      ...pair('Não são sinônimos', doc.vocabulary?.not_synonyms),
      ...pair('Outra acepção em outra área', doc.vocabulary?.other_domain_meanings),
    ]);
    add('Exemplos que ajudam a decidir', [
      ...pair('Exemplo', doc.examples),
      ...pair('Contraexemplo', doc.counterexamples),
      ...pair('Caso-limite', doc.boundary_cases),
    ]);
    break;
  case 'processo':
    add('Como o processo funciona', [
      ...question(),
      ...pair('Objetivo', doc.intent?.purpose),
      ...pair('O que inicia o processo', doc.trigger, true),
      ...pair('Quando se aplica', doc.scope?.applies_when),
      ...pair('Quando não se aplica', doc.scope?.not_applicable_when),
      ...pair('Resultado esperado', doc.completion?.success_criteria),
    ]);
    add('Etapas e responsáveis', [], [], (doc.steps ?? []).map((step: any) => ({
      heading: `${step.id ?? ''} · ${step.name ?? 'Etapa'}`,
      body: display(step.action),
      note: [
        present(step.performer_role) ? `Responsável: ${display(step.performer_role)}` : null,
        present(step.next_step) ? `Próximo passo: ${display(step.next_step)}` : null,
        present(step.output_evidence) ? `Evidência: ${display(step.output_evidence)}` : null,
      ].filter(Boolean).join(' · '),
      detail: present(step.exception_handling) ? `Exceção: ${display(step.exception_handling)}` : undefined,
    })));
    add('Desvios e encerramento', [
      ...pair('Exceções', doc.exceptions),
      ...pair('Escalonamento', doc.escalation),
      ...pair('Resultados sem sucesso', doc.completion?.failure_outcomes),
    ]);
    break;
  case 'decisao': {
    add('Qual decisão precisa ser documentada', [
      ...question(),
      ...pair('Finalidade', doc.intent?.purpose),
      ...pair('Quando se aplica', doc.scope?.applies_when),
      ...pair('Fora do escopo', doc.scope?.not_applicable_when),
    ]);
    add('O que cada entrada significa', [], [],
      (doc.required_inputs ?? []).map((input: any) => ({
        heading: decisionInputLabel(input.name),
        body: display(input.definition),
        note: present(input.allowed_values)
          ? `Valores possíveis: ${(input.allowed_values ?? []).map(decisionValue).join(', ')}`
          : undefined,
      })));
    const inputs: string[] = (doc.required_inputs ?? []).map((v: any) => v.name);
    if (inputs.length && Array.isArray(doc.decision_table) && doc.decision_table.length) {
      decisionTable = {
        labels: [...inputs.map(decisionInputLabel), 'Encaminhamento'],
        rows: doc.decision_table.map((r: any) => [
          ...inputs.map((input: string) => decisionValue(r.when?.[input] ?? 'any')),
          decisionValue(r.then),
        ]),
      };
    }
    add('Limites e exceções', [
      ...pair('Condição desconhecida', doc.unknown_input_behavior ? decisionValue(doc.unknown_input_behavior) : null),
      ...pair('Prioridade ou conflitos resolvidos', doc.priority_rules),
    ], [], (doc.exceptions ?? []).map((v: any) => ({
      heading: display(v.condition),
      body: `Quem autoriza: ${display(v.approval_role)}`,
      note: `Evidência necessária: ${display(v.evidence_needed)}`,
    })));
    add('Pedidos usados para testar a tabela', [], [], (doc.tests ?? []).filter((v: any) => present(v.case)).map((v: any) => ({
      heading: display(v.case),
      body: `Encaminhamento: ${decisionValue(v.expected_outcome)}`,
      note: present(v.reasoning) ? display(v.reasoning) : undefined,
    })));
    break;
  }
  case 'evento-coleta': {
    const comportamento = doc.expected_behavior ?? {};
    add('Pergunta e gatilho', [
      ...question(),
      ...pair('Finalidade', doc.intent?.purpose),
      ...pair('O que faz o evento disparar', doc.trigger, true),
      ...pair('Informações enviadas com cada disparo', (doc.parameters ?? []).map((v: any) =>
        `${display(v.name)}: ${display(v.meaning)}${v.required === true ? ' (sempre presente)' : ''}`)),
      ...pair('Lançado em', dia(doc.launch_date)),
      ...pair('Desativado em', dia(doc.retirement_date)),
    ]);
    add('Onde dispara, por operação', [
      ...pair('Para onde vão os disparos', (doc.destination ?? []).map((v: any) =>
        `${display(v.platform)}: ${display(v.object)}${present(v.timezone) ? ` (fuso: ${display(v.timezone)})` : ''}`)),
    ], [], (doc.active_scopes ?? []).map((v: any) => ({
      heading: [v.operation, v.country, v.brand].filter(present).map(display).join(' · ') || 'Operação',
      body: v.active === true
        ? (present(v.since) ? `Ativo desde ${dia(v.since)}` : 'Ativo, data de início ainda não definida')
        : v.active === false ? 'Não está ativo aqui: zero é o esperado' : 'Ainda não se sabe se está ativo',
      note: present(v.reason) ? display(v.reason) : undefined,
    })));
    add('Comportamento esperado e linha de base', [
      ...pair('Frequência esperada', comportamento.expected_frequency, true),
      ...pair('Sazonalidade', comportamento.seasonality),
      ...pair('Tolerância ao silêncio', (comportamento.silence_tolerance ?? []).map((v: any) =>
        `${display(v.operation)}: ${display(v.rule)}`)),
    ], [], (comportamento.baseline_by_scope ?? []).map((v: any) => ({
      heading: `Linha de base de ${display(v.operation)}`,
      body: present(v.window) ? `Janela: ${display(v.window)}` : undefined,
      items: [v.typical_daily, v.zero_days_share, v.longest_zero_run].filter(present).map(display),
    })));
    add('Quando zero é normal', [
      ...pair('Situações em que zero não indica problema', list(comportamento.expected_zero_conditions)),
      ...pair('Dia sem linha na tabela', doc.missing_days_policy),
      ...pair('O que uma linha representa', doc.grain_note),
      ...pair('Quando o dia fica completo', doc.late_arrival_window),
    ]);
    add('Exceções e incidentes', [
      ...pair('Consentimento exigido', doc.consent_requirements),
      ...pair('Como reconhecer disparo repetido', doc.deduplication_key),
      ...pair('Indicadores que dependem do evento', list(doc.downstream_kpis)),
      ...pair('Não confundir', (doc.disambiguation ?? []).map((v: any) =>
        `${display(v.term)} quer dizer ${display(v.means)}; não é ${display(v.not_to_confuse_with)}`)),
    ], [], [
      ...(doc.known_exceptions ?? []).map((v: any) => ({
        heading: `Exceção: ${display(v.condition)}`,
        body: `Período: ${display(v.period)}`,
        note: present(v.evidence) ? `Evidência: ${display(v.evidence)}` : undefined,
      })),
      ...(doc.data_incidents ?? []).map((v: any) => ({
        heading: `Incidente de ${display(dia(v.start))} a ${display(dia(v.end))}`,
        body: display(v.description),
        note: present(v.effect_on_baseline) ? `Efeito na linha de base: ${display(v.effect_on_baseline)}` : undefined,
        detail: present(v.status) ? `Situação: ${display(v.status)}` : undefined,
      })),
    ]);
    add('Instruções ao agente', [
      ...pair('Instrução', doc.context?.instructions),
      ...pair('Limites', (doc.context?.constraints ?? []).map((v: any) => v?.constraint).filter(present)),
    ], [], (doc.context?.verifiedStatements ?? []).filter((v: any) => present(v?.question)).map((v: any) => ({
      heading: display(v.question),
      body: present(v.answer) ? `Resposta conferida: ${display(v.answer)}` : 'Pergunta típica, ainda sem resposta conferida',
    })));
    break;
  }
  case 'politica':
    add('Aplicação e autoridade da política', [
      ...question(),
      ...pair('Finalidade', doc.intent?.purpose),
      ...pair('Público', doc.scope?.audiences),
      ...pair('Atividades', doc.scope?.activities),
      ...pair('Fora do escopo', doc.scope?.exclusions),
      ...pair('Emissor da política', doc.authority?.issuing_body),
      ...pair('Versão da política de origem', doc.authority?.version),
      ...pair('Vigência da política de origem', doc.authority?.effective_date),
    ]);
    add('Obrigações, permissões e proibições', [
      ...pair('É obrigatório', doc.obligations),
      ...pair('É permitido', doc.permissions),
      ...pair('É proibido', doc.prohibitions),
    ]);
    add('Exceções e divergências', [
      ...pair('Fonte que prevalece', doc.source_precedence_rule),
      ...pair('Como verificar', doc.how_to_verify),
    ], [], [
      ...(doc.exceptions ?? []).map((v: any) => ({
        heading: `Exceção: ${display(v.condition)}`,
        body: `Autorização: ${display(v.approval_role)}`,
        note: `Evidência: ${display(v.evidence_needed)}`,
      })),
      ...(doc.conflicting_sources ?? []).map((v: any) => ({
        heading: `Conflito: ${display(v.description)}`,
        body: `Estado: ${v.state === 'resolved' ? 'Resolvido' : 'Em aberto'}`,
        items: (v.positions ?? []).map((x: any) => `${display(x.source)}: ${display(x.says)}`),
        detail: present(v.impact) ? `Impacto: ${display(v.impact)}` : undefined,
        note: present(v.resolution) ? `Decisão registrada: ${display(v.resolution)}` : 'Sem resolução aprovada',
      })),
    ]);
    break;
  case 'kpi':
    add('O significado do indicador', [
      ...question(),
      ...pair('O que mede', doc.business_definition?.concept, true),
      ...pair('Objetivo', doc.intent?.purpose),
      ...pair('Numerador', doc.calculation?.numerator, true),
      ...pair('Denominador', doc.calculation?.denominator, true),
      ...pair('Fórmula', doc.calculation?.formula_description, true),
      ...pair('Agregação', doc.calculation?.aggregation_rule),
      ...pair('Sem denominador', doc.calculation?.zero_denominator_policy),
    ]);
    add('Escopo e limitações', [
      ...pair('População', doc.scope?.applicable_population),
      ...pair('Canais incluídos', doc.scope?.included_channels),
      ...pair('Canais excluídos', doc.scope?.excluded_channels),
      ...pair('Exclusões', doc.scope?.exclusions),
      ...pair('Data de referência', doc.time?.reference_date_field),
      ...pair('Fuso e calendário', doc.time?.timezone),
      ...pair('Fonte autorizada', doc.data_sources?.authoritative_dataset),
      ...pair('Casos-limite', doc.validation?.known_edge_cases),
    ]);
    break;
  case 'dataset':
    add('O que cada registro representa', [
      ...question(),
      ...pair('Tabela', doc.dataset?.physicalName),
      ...pair('Objetivo', doc.intent?.purpose),
      ...pair('Granularidade (uma linha)', doc.dataset?.grain, true),
      ...pair('Chave primária', doc.dataset?.primary_key),
      ...pair('Tempo e atualização', doc.time_semantics?.timezone),
    ]);
    add('Dicionário dos campos', [], [], (doc.columns ?? []).map((v: any) => ({
      heading: `${display(v.businessName)} · ${display(v.physicalName)}`,
      body: display(v.meaning),
      note: present(v.allowed_values) ? `Valores documentados: ${display(v.allowed_values)}` : undefined,
      detail: present(v.do_not_use_for) ? `Não usar para: ${display(v.do_not_use_for)}` : undefined,
    })));
    add('Como não interpretar estes dados', [
      ...pair('Agregações inválidas', doc.usage?.invalid_aggregations),
      ...pair('Limitações conhecidas', doc.usage?.known_caveats),
    ]);
    break;
  case 'relacionamento':
    add('Por que as tabelas se relacionam', [
      ...question(),
      ...pair('Finalidade', doc.intent?.purpose),
      ...pair('Tabela de origem', doc.left?.dataset),
      ...pair('Uma linha da origem', doc.left?.grain),
      ...pair('Tabela de destino', doc.right?.dataset),
      ...pair('Uma linha do destino', doc.right?.grain),
      ...pair('Cardinalidade', doc.cardinality === 'one_to_many' ? 'Uma origem pode ter muitos registros de destino (1:N)' : doc.cardinality),
      ...pair('Chaves utilizadas', (doc.join_keys ?? []).map((v: any) => `${v.left} → ${v.right}`)),
    ]);
    add('Quando a junção gera problemas', [
      ...pair('Risco de duplicação', doc.usage_rules?.duplication_risks),
      ...pair('Contagens seguras', doc.usage_rules?.aggregation_safeguards),
      ...pair('Junções proibidas', doc.usage_rules?.disallowed_question_classes),
      ...pair('Regra temporal', doc.coverage?.temporal_join_rule),
    ]);
    break;
  case 'dashboard':
    add('Como interpretar o dashboard', [
      ...question(),
      ...pair('Finalidade', doc.intent?.purpose),
      ...pair('Público', doc.intent?.audience),
      ...pair('Indicadores', (doc.metrics ?? []).map((m: string) => doc.metric_versions?.[m] ? `${m}, versão ${doc.metric_versions[m]}` : m)),
      ...pair('Filtros padrão', doc.default_filters ? Object.entries(doc.default_filters).map(([k, v]) => `${k}: ${display(v)}`) : []),
      ...pair('Período', doc.time_semantics?.reporting_period),
      ...pair('Referência comparativa', doc.time_semantics?.comparison_baseline),
      ...pair('Atualização', doc.freshness?.refresh_frequency),
      ...pair('Status como fonte', doc.official_or_exploratory),
    ]);
    add('O que este dashboard não permite concluir', [
      ...pair('Limitações', doc.known_limitations),
      ...pair('Decisões que apoia', doc.intent?.decisions),
    ], [], (doc.conflicting_dashboards ?? []).filter((v: any) => typeof v === 'object').map((v: any) => ({
      heading: `Conflito: ${display(v.name)} mostra “${display(v.shows)}”`,
      body: display(v.cause),
      note: present(v.precedence) ? `Qual vale: ${display(v.precedence)}` : undefined,
    })));
    break;
  case 'rubrica':
    add('Objeto e cuidados da avaliação', [
      ...question(),
      ...pair('O que é avaliado', doc.evaluation_target),
      ...pair('Objetivo', doc.intent?.purpose),
      ...pair('Uso permitido', doc.allowed_use),
      ...pair('Uso proibido', doc.disallowed_use),
      ...pair('Como calcular a nota', doc.scoring?.formula),
      ...pair('Ligação com outra decisão', doc.scoring?.feeds_decision),
      ...pair('Quando falta evidência', doc.scoring?.not_evaluable_rule ?? (doc.scoring?.missing_evidence_behavior === 'not_evaluable' ? 'Critério fica como não avaliável, em vez de zero; como calcular a nota nesse caso ainda está em aberto' : doc.scoring?.missing_evidence_behavior)),
      ...pair('Revisão humana', doc.human_review_required === true ? 'Obrigatória' : null),
    ]);
    add('Critérios e níveis observáveis', [], [], (doc.criteria ?? []).map((v: any) => ({
      heading: `${display(v.name)} · peso ${display(v.weight)}%`,
      body: display(v.definition),
      note: present(v.not_in_scope) ? `Não avalia: ${display(v.not_in_scope)}` : undefined,
      levels: v.anchors ?? undefined,
    })));
    add('Calibração e divergências', [
      ...pair('Resolução de discordâncias', doc.disagreement_resolution),
    ], [], (doc.calibration_examples ?? []).filter((v: any) => typeof v === 'object').map((v: any) => ({
      heading: display(v.case),
      body: present(v.expected) ? display(v.expected) : undefined,
      items: v.levels ? Object.entries(v.levels).map(([id, level]) => {
        const name = (doc.criteria ?? []).find((c: any) => c.id === id)?.name ?? id;
        const why = v.justification?.[id];
        return `${name}: nível ${level}${why ? `. ${why}` : ''}`;
      }) : undefined,
      note: v.score !== undefined ? `Nota ${String(v.score).replace('.', ',')} de 100 · evidência ${v.evidence_sufficient ? 'suficiente' : 'insuficiente'} · ${decisionValue(v.routing)}` : undefined,
    })));
    break;
  case 'perguntas-de-negocio':
    add('Finalidade do gabarito', [
      ...question(),
      ...pair('Para que serve', doc.intent?.purpose),
      ...pair('Domínio', doc.domain),
      ...pair('Versão das definições utilizadas', doc.depends_on_versions
        ? Object.entries(doc.depends_on_versions).map(([k, v]) => `${k}@${v}`) : null),
    ]);
    add('O que se pode responder, esclarecer ou recusar', [], [], (doc.questions ?? []).map((v: any) => ({
      heading: `${display(v.id)} · ${display(v.question)}`,
      body: v.expected_behavior === 'answer'
        ? `Responder: ${display(v.reference_answer)}`
        : v.expected_behavior === 'clarify'
        ? `Pedir esclarecimento: ${display(v.reference_answer ?? v.ambiguity)}`
        : `Não responder com número: ${display(v.reason_if_abstain)}`,
      note: [
        ...(v.also_accepted ?? []).map((a: any) => `Outra forma aceita (${display(a.behavior)}): ${display(a.condition)}`),
        ...(present(v.evidence_description) ? [`Fundamento: ${display(v.evidence_description)}`] : []),
      ].join('. ') || undefined,
    })));
    break;
  default:
    add('Conteúdo do documento', [...question(), ...pair('Finalidade', doc.intent?.purpose ?? doc.definition)]);
}
---
<section class="example-meaning" aria-label="Conteúdo principal do documento em linguagem natural">
  {groups.map((group) => <section class="example-meaning__group">
    <Titulo class="example-meaning__heading">{group.heading}</Titulo>
    {group.pairs && group.pairs.length > 0 && <dl class="example-meaning__facts">
      {group.pairs.map((p) => <div><dt>{p.label}</dt><dd>{p.items
        ? <ul class="example-meaning__list">{p.items.map((item) => <li>{item}</li>)}</ul>
        : p.value}</dd></div>)}
    </dl>}
    {group.bullets && group.bullets.length > 0 && <ul>{group.bullets.map(b => <li>{b}</li>)}</ul>}
    {group.entries && group.entries.length > 0 && <ol class="example-meaning__entries">
      {group.entries.map((entry) => <li>
        <strong>{entry.heading}</strong>
        {entry.body && <p>{entry.body}</p>}
        {entry.items && entry.items.length > 0 && <ul class="example-meaning__list">{entry.items.map((item) => <li>{item}</li>)}</ul>}
        {entry.note && <p class="example-meaning__note">{entry.note}</p>}
        {entry.detail && <p class="example-meaning__note">{entry.detail}</p>}
        {entry.levels && Object.keys(entry.levels).length > 0 &&
          <details class="example-meaning__levels">
            <summary>Consultar os critérios dos níveis 0 a 4</summary>
            <dl>{Object.entries(entry.levels).map(([level, meaning]) =>
              <div><dt>Nível {level}</dt><dd>{meaning}</dd></div>)}</dl>
          </details>}
      </li>)}
    </ol>}
  </section>)}
  {decisionTable && <section class="example-meaning__group">
    <Titulo class="example-meaning__heading">Tabela de encaminhamento</Titulo>
    <div class="example-meaning__table-scroll" role="region" aria-label="Tabela de decisão com rolagem horizontal" tabindex="0">
      <table>
        <thead><tr>{decisionTable.labels.map(label => <th scope="col">{label}</th>)}</tr></thead>
        <tbody>{decisionTable.rows.map(row => <tr>{row.map(value => <td>{value}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </section>}
</section>
