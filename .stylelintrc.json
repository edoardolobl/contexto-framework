{
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "declaration-no-important": true,
    "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch"]
  },
  "overrides": [
    {
      "files": ["src/styles/custom.css"],
      "rules": {
        "color-no-hex": null,
        "selector-disallowed-list": ["/^(?!:root)/"]
      }
    }
  ]
}
